server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compresión (los estáticos ya vienen gzip por Vite, pero por si acaso)
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Headers de seguridad (además de los de Django hardening)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Resolver Docker interno — resuelve "backend" en cada request, no al iniciar
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Proxy al backend Django (variable de entorno API_UPSTREAM)
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        client_max_body_size 10M;  # subir fotos incidencias
    }

    # Media del backend (uploads) — servido directo desde volumen compartido
    # Media del backend.
    #
    # NO se sirve entero, y es lo importante de este bloque: acá adentro viven
    # fotos de estudiantes, adjuntos de casos de convivencia, justificaciones
    # de inasistencia y licencias médicas del personal. Servirlas por nginx
    # significaba que cualquiera con la URL se las bajaba sin sesión, y encima
    # con `Cache-Control: public` por siete días — o sea también quedaban en
    # cachés intermedias. El volumen está montado acá por
    # `docker-compose.prod.yml`, así que no era un riesgo teórico.
    #
    # Ahora se piden por `GET /api/archivos/<token>/` con un enlace firmado y
    # con vencimiento, que emite el backend dentro de respuestas que sí exigen
    # sesión. Ver `backend/apps/core/archivos.py`.
    #
    # Lo único público a propósito es el logo, que es branding y no dato de
    # nadie. Sólo esa carpeta: así, lo que se guarde mañana en media/ no queda
    # expuesto por descuido.
    location /media/logos/ {
        alias /usr/share/nginx/html/media/logos/;
        expires 7d;
        add_header Cache-Control "public";
    }

    # El resto no existe para el mundo. Explícito y no por omisión: sin esta
    # regla caería en el fallback de la SPA y devolvería el index.html con un
    # 200, que despista a quien depure esto después.
    location /media/ {
        return 404;
    }

    # Estáticos con cache agresivo (Vite pone hash en el nombre)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: cualquier ruta no encontrada → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # robots.txt y favicon: no loggear
    location = /robots.txt { access_log off; log_not_found off; }
    location = /favicon.svg { access_log off; log_not_found off; }

    # Health check para Fly.io
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}

# ═══════════════════════════════════════════════════════════════════════════
# Variables de producción — COPIAR A .env.prod y LLENAR VALORES REALES
#
# NUNCA committear .env.prod al repo (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ── Django ─────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIAR_ESTA_CLAVE_POR_UNA_ALEATORIA

# Dominios permitidos, separados por coma
ALLOWED_HOSTS=edumwork-backend.fly.dev,sistema.tu-colegio.edu.pe

# CORS extra (si el frontend está en dominio distinto al backend)
CORS_EXTRA_ORIGINS=https://edumwork-backend.fly.dev

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=edumwork
POSTGRES_USER=edumwork
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE

# ── Cifrado de API keys IA (Fernet) ────────────────────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IA_ENCRYPTION_KEY=CAMBIAR_CLAVE_FERNET_BASE64

# ── Edición del sistema ────────────────────────────────────────────────────
# "completa"     → todos los roles (director, docente, admin_tic, padre, estudiante, ugel)
# "solo_docente" → sub-app para colegios chicos: solo rol=docente
EDICION=completa

# ── Frontend público (enlaces de invitación, reset, etc.) ──────────────────
FRONTEND_URL=https://sistema.tu-colegio.edu.pe

# ── Email ──────────────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=no-reply@edumwork.pe
# Para producción real, cambiar a SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Puerto HTTP público ────────────────────────────────────────────────────
# 80 para producción real, 8080 si vas a poner un reverse proxy delante
HTTP_PORT=80

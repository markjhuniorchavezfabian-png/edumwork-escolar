# ═══════════════════════════════════════════════════════════════════════════
# Ejemplo de .env para una instalación de colegio (generado por install_colegio.sh)
# NO commitear el .env real — contiene secretos.
# ═══════════════════════════════════════════════════════════════════════════

# Imágenes Docker
DOCKER_REGISTRY=docker.io
IMAGE_PREFIX=edumwork
VERSION=latest

# Colegio
NOMBRE_COLEGIO=Mi Institución Educativa
CODIGO_MODULAR=
UGEL=

# Director inicial
DIRECTOR_NOMBRE=Director Ejemplo
DIRECTOR_EMAIL=director@tucolegio.edu.pe
DIRECTOR_PASSWORD=cambiar_esto_antes_de_entregar

# Django
SECRET_KEY=generar_con_secrets_token_urlsafe_50
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.edu.pe
CORS_EXTRA_ORIGINS=https://tu-dominio.edu.pe
FRONTEND_URL=https://tu-dominio.edu.pe
SECURE_SSL_REDIRECT=False

# PostgreSQL
POSTGRES_DB=edumwork
POSTGRES_USER=edumwork
POSTGRES_PASSWORD=generar_password_fuerte

# Cifrado IA
IA_ENCRYPTION_KEY=clave_fernet_base64

# Zona horaria
TZ=America/Lima

# Rendimiento
GUNICORN_WORKERS=2

# Email (console en dev, SMTP en prod)
DEFAULT_FROM_EMAIL=no-reply@edumwork.pe
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

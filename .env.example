# Backend
SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=edumwork
POSTGRES_USER=edumwork
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=localhost
# 5433 y no 5432: el contenedor de este proyecto publica en 5433
# (ver `ports` en docker-compose.yml) porque el 5432 del equipo lo ocupa
# el Postgres de p_02. Con 5432 acá, `pytest` desde el host se conecta al
# servidor equivocado y falla con "password authentication failed for user
# edumwork", que no dice nada de puertos y manda a buscar por el lado que no es.
# DENTRO de Docker esto no aplica: ahí el backend usa `db:5432` y el default
# de settings.py es el correcto — por eso el default no se toca.
POSTGRES_PORT=5433


# IA — Clave para cifrado de API keys (BYOK). Generar con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IA_ENCRYPTION_KEY=cambiar-por-clave-fernet-real

# Frontend
VITE_API_URL=http://localhost:8000/api

# URL pública del frontend (enlaces de invitación, reset, etc.)
FRONTEND_URL=http://localhost:5173

# ═════════════════════════════════════════════════════════════════════════════
# SIZING — ajustar según el tamaño del VPS del cliente
# Los defaults están optimizados para VPS de 2 GB / 200 alumnos.
# Para colegios más grandes, subir los valores según la tabla:
#
#   VPS RAM   PG_SHARED_BUFFERS   PG_EFFECTIVE_CACHE_SIZE   GUNICORN_WORKERS
#   ────────  ─────────────────   ───────────────────────   ────────────────
#   1 GB      64MB                192MB                     1
#   2 GB      128MB (default)     384MB (default)           2–3 (default)
#   4 GB      512MB               1536MB                    4
#   8 GB      1GB                 3GB                       6
#
# PG_MAX_CONNECTIONS: default 30. Subir a 100 si el colegio supera 500 usuarios activos.
# PG_WORK_MEM: default 4MB. Subir a 16MB si hay reportes pesados frecuentes.
# ═════════════════════════════════════════════════════════════════════════════

# GUNICORN_WORKERS=3
# PG_SHARED_BUFFERS=128MB
# PG_EFFECTIVE_CACHE_SIZE=384MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=32MB
# PG_MAX_CONNECTIONS=30
